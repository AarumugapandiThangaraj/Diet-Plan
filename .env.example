# Diet Plan Studio - Environment Variables Template

# Database Configuration
# Supported drivers: postgresql+asyncpg (async PostgreSQL), sqlite+aiosqlite (async SQLite)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nutri

# AI Companion Model (Ollama)
# NUTRI_OLLAMA_MODEL specifies the model tag used by the local Ollama instance
NUTRI_OLLAMA_MODEL=gemma3:4b

# Data Configuration
# NUTRI_DATA_ROOT points to the multi-cuisine recipe and ingredient JSON assets root folder
# NUTRI_DATA_ROOT=../Data new

# Cache settings
# NUTRI_CACHE_SIZE=32
